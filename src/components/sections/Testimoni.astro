---
import { getCollection, render } from 'astro:content';
const items = await Promise.all(
  (await getCollection('testimoni')).map(async (e) => ({ d: e.data, Content: (await render(e)).Content })),
);
---
<section id="testimoni" data-section="testimoni" aria-labelledby="testi-judul">
  <div class="wrap" data-reveal>
    <h2 id="testi-judul">Testimoni</h2>
    <ul class="grid">
      {items.map(({ d, Content }) => (
        <li>
          <figure class="card" style="margin:0">
            <blockquote><Content /></blockquote>
            <figcaption>{d.nama}, {d.peran} — {d.organisasi}</figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>
