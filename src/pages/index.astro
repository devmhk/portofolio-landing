---
import BaseLayout from '../layouts/BaseLayout.astro';
import { persona } from '../data/site';
import Hero from '../components/sections/Hero.astro';
import ProofStrip from '../components/sections/ProofStrip.astro';
import StudiKasus from '../components/sections/StudiKasus.astro';
import Keahlian from '../components/sections/Keahlian.astro';
import CaraKerja from '../components/sections/CaraKerja.astro';
import Tulisan from '../components/sections/Tulisan.astro';
import Testimoni from '../components/sections/Testimoni.astro';
import Kontak from '../components/sections/Kontak.astro';
import Footer from '../components/sections/Footer.astro';
---
<BaseLayout title={`${persona.nama} — ${persona.peran}`}>
  <main id="main" tabindex="-1">
    <Hero />
    <ProofStrip />
    <StudiKasus />
    <Keahlian />
    <CaraKerja />
    <Tulisan />
    <Testimoni />
    <Kontak />
  </main>
  <Footer />
</BaseLayout>
